{
  "name": "fcplcn-cloud",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "format:web": "node ../tools/web/format-code.mjs --project cloud",
    "format:web:check": "node ../tools/web/format-code.mjs --project cloud --check",
    "typecheck": "tsc --noEmit",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-server.mjs",
    "build:web": "vite build && node scripts/package-web.mjs",
    "build": "npm run typecheck && npm run build:server && npm run build:web",
    "start": "node --env-file-if-exists=.env dist/cloud/server/main.js",
    "test": "npm run build:server && node --test --test-concurrency=1 dist/cloud/tests/*.test.js",
    "test:browser": "node tests/browser.cjs",
    "check": "npm run build && npm test && npm run test:browser"
  },
  "dependencies": {
    "mqtt": "5.16.1",
    "pg": "8.23.1",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
