# Copy to .env and configure the LAN broker. Hub web login starts as admin / empty password.
FCPLCN_HUB_HOST=127.0.0.1
FCPLCN_HUB_PORT=3000
FCPLCN_HUB_MODE=mqtt
FCPLCN_HUB_PASSWORD=
# Optional first-start password only. Later changes are saved through Account in the web panel.
FCPLCN_HUB_MQTT_URL=mqtt://127.0.0.1:1883
FCPLCN_HUB_MQTT_USERNAME=fcplcn-hub
FCPLCN_HUB_MQTT_PASSWORD=
FCPLCN_HUB_DATA_DIR=./data
# Docker Compose requires two distinct random passwords (for example openssl rand -hex 32).
# install.sh and update.sh generate them automatically for managed installations.
FCPLCN_HUB_DATABASE_PASSWORD=
FCPLCN_HUB_DATABASE_ADMIN_PASSWORD=
# For a manual Node.js start with an existing PostgreSQL server instead of Compose:
# FCPLCN_HUB_DATABASE_URL=postgresql://fcplcn_hub:PASSWORD@127.0.0.1:5432/fcplcn_hub

# Docker Compose publishes these interfaces; keep them on the private LAN.
FCPLCN_HUB_BIND=0.0.0.0
FCPLCN_MQTT_BIND=0.0.0.0
