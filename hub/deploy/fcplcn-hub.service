[Unit]
Description=FCPLCn local home automation hub
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=fcplcn
Group=fcplcn
WorkingDirectory=/opt/fcplcn/hub
Environment=NODE_ENV=production
Environment=FCPLCN_HUB_DATA_DIR=/var/lib/fcplcn
EnvironmentFile=/etc/fcplcn/hub.env
ExecStart=/usr/bin/node /opt/fcplcn/hub/dist/server/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
StateDirectory=fcplcn
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fcplcn
CapabilityBoundingSet=
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
