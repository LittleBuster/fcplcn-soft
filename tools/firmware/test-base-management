#!/bin/sh
set -eu
MANAGEMENT_TOOLS_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
MANAGEMENT_SOURCE_DIR="$MANAGEMENT_TOOLS_DIR/../../firmware/base/tests/management"
MANAGEMENT_BUILD_DIR="${FCPLCN_MANAGEMENT_BUILD_DIR:-$HOME/esp/build/fcplcn/base-management}"
export PATH="/opt/homebrew/bin:$PATH"
cmake -S "$MANAGEMENT_SOURCE_DIR" -B "$MANAGEMENT_BUILD_DIR" -G Ninja -DOPENSSL_ROOT_DIR=/opt/homebrew/opt/openssl@3 "$@"
cmake --build "$MANAGEMENT_BUILD_DIR" --parallel
ctest --test-dir "$MANAGEMENT_BUILD_DIR" --output-on-failure
