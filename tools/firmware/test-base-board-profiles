#!/bin/sh
set -eu
PROFILE_TOOLS_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PROFILE_SOURCE_DIR="$PROFILE_TOOLS_DIR/../../firmware/base/tests/board_profiles"
PROFILE_BUILD_DIR="${FCPLCN_BOARD_PROFILES_BUILD_DIR:-$HOME/esp/build/fcplcn/base-board-profiles}"
export PATH="/opt/homebrew/bin:$PATH"
cmake -S "$PROFILE_SOURCE_DIR" -B "$PROFILE_BUILD_DIR" -G Ninja "$@"
cmake --build "$PROFILE_BUILD_DIR" --parallel
ctest --test-dir "$PROFILE_BUILD_DIR" --output-on-failure
