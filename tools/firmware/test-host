#!/bin/sh
set -eu

HOST_SETUP_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
HOST_SOURCE_DIR="$HOST_SETUP_DIR/host-smoke"
HOST_BUILD_DIR="$HOST_SOURCE_DIR/.build"

find_host_tool() {
    if command -v "$1" >/dev/null 2>&1; then
        command -v "$1"
    elif [ -x "/opt/homebrew/bin/$1" ]; then
        printf '%s\n' "/opt/homebrew/bin/$1"
    else
        printf 'Required host build tool not found: %s\n' "$1" >&2
        return 1
    fi
}

HOST_CMAKE_BIN="$(find_host_tool cmake)"
HOST_CTEST_BIN="$(find_host_tool ctest)"
HOST_NINJA_BIN="$(find_host_tool ninja)"

"$HOST_CMAKE_BIN" -S "$HOST_SOURCE_DIR" -B "$HOST_BUILD_DIR" \
    -G Ninja "-DCMAKE_MAKE_PROGRAM=$HOST_NINJA_BIN"
"$HOST_CMAKE_BIN" --build "$HOST_BUILD_DIR" --parallel
"$HOST_CTEST_BIN" --test-dir "$HOST_BUILD_DIR" --output-on-failure "$@"
