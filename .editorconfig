root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,cjs,mjs,ts,tsx,css,html,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{kicad_pcb,kicad_sch,kicad_pro}]
trim_trailing_whitespace = false
